<UserControl
	x:Class="PPTService.BottomArea" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pptService="clr-namespace:PPTService" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Images_/Images.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/ButtonStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/CheckBoxStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/RadioButtonStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Storyboard
				x:Key="ShowColorDiskStoryBoard">
				<DoubleAnimationUsingKeyFrames
					Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
					Storyboard.TargetName="ColorDiskStoryBoardGrid">
					<EasingDoubleKeyFrame
						KeyTime="0"
						Value="0" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.3"
						Value="1">
						<EasingDoubleKeyFrame.EasingFunction>
							<BackEase
								Amplitude="0.2" />
						</EasingDoubleKeyFrame.EasingFunction>
					</EasingDoubleKeyFrame>
				</DoubleAnimationUsingKeyFrames>
				<DoubleAnimationUsingKeyFrames
					Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
					Storyboard.TargetName="ColorDiskStoryBoardGrid">
					<EasingDoubleKeyFrame
						KeyTime="0"
						Value="0" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.3"
						Value="1">
						<EasingDoubleKeyFrame.EasingFunction>
							<BackEase
								Amplitude="0.2" />
						</EasingDoubleKeyFrame.EasingFunction>
					</EasingDoubleKeyFrame>
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="RootGrid"
		Height="50">
		<UIElement.RenderTransform>
			<TranslateTransform
				Y="0" />
		</UIElement.RenderTransform>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="28" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="Auto" />
		</Grid.ColumnDefinitions>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup
				x:Name="AdaptiveStates">
				<VisualState
					x:Name="Adaptive0">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="BottomCenterButtonGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="178" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="RootGrid"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="PlaceholderGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="2" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ExitGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="58.0" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ShareGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="88.0" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="BackgroundBorder"
							Storyboard.TargetProperty="CornerRadius">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<CornerRadius>3</CornerRadius>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="LeftBackgroundBorder"
							Storyboard.TargetProperty="CornerRadius">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<CornerRadius>3</CornerRadius>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskPopup"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="90" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskPopup"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskGrid"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="15" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskGrid"
							Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<Thickness>0 0 0 4</Thickness>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState
					x:Name="Adaptive1440" />
				<VisualState
					x:Name="Adaptive3800">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="BottomCenterButtonGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="528" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="RootGrid"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="100" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="PlaceholderGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="8" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ExitGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="128.0" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ShareGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="228.0" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="BackgroundBorder"
							Storyboard.TargetProperty="CornerRadius">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<CornerRadius>12</CornerRadius>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="LeftBackgroundBorder"
							Storyboard.TargetProperty="CornerRadius">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<CornerRadius>12</CornerRadius>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskPopup"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="300" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskPopup"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="100" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskGrid"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="50" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="ColorDiskGrid"
							Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<Thickness>0 0 0 14</Thickness>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<pptService:AdaptiveTrigger
				MinWindowWidth="0">
				<ei:GoToStateAction
					StateName="Adaptive0" />
			</pptService:AdaptiveTrigger>
			<pptService:AdaptiveTrigger
				MinWindowWidth="1440">
				<ei:GoToStateAction
					StateName="Adaptive1440" />
			</pptService:AdaptiveTrigger>
			<pptService:AdaptiveTrigger
				MinWindowWidth="3800">
				<ei:GoToStateAction
					StateName="Adaptive3800" />
			</pptService:AdaptiveTrigger>
		</i:Interaction.Triggers>
		<Grid
			Name="DragHandleGrid"
			Grid.Column="0"
			Width="28"
			Background="#40FFFFFF"
			Cursor="SizeAll"
			Tag="DragHandle">
			<Canvas
				Width="10"
				Height="30"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Opacity="0.6">
				<Ellipse Canvas.Left="0" Canvas.Top="0" Width="4" Height="4" Fill="#80666666" />
				<Ellipse Canvas.Left="6" Canvas.Top="0" Width="4" Height="4" Fill="#80666666" />
				<Ellipse Canvas.Left="0" Canvas.Top="7" Width="4" Height="4" Fill="#80666666" />
				<Ellipse Canvas.Left="6" Canvas.Top="7" Width="4" Height="4" Fill="#80666666" />
				<Ellipse Canvas.Left="0" Canvas.Top="14" Width="4" Height="4" Fill="#80666666" />
				<Ellipse Canvas.Left="6" Canvas.Top="14" Width="4" Height="4" Fill="#80666666" />
			</Canvas>
		</Grid>
		<Grid
			Name="ShareGrid"
			Column="1"
			Width="100">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Border
				Name="LeftBackgroundBorder"
				Grid.ColumnSpan="2"
				CornerRadius="6"
				Background="#A0FFFFFF"
				BorderThickness="1"
				BorderBrush="#80666666" />
			<pptService:ImageButton
				Tag="Interactive"
				Click="Recommendation_OnClick"
				Grid.Column="0"
				NormalSource="{StaticResource ImageSource.RecommendationNormal}"
				PressedSource="{StaticResource ImageSource.RecommendationPressed}" />
			<pptService:ImageButton
				Tag="Interactive"
				Click="Share_OnClick"
				Grid.Column="1"
				NormalSource="{StaticResource ImageSource.ShareNormal}"
				PressedSource="{StaticResource ImageSource.SharePressed}" />
		</Grid>
		<Grid
			Column="1"
			Width="4" />
		<Grid
			Name="BottomCenterButtonGrid"
			Column="2"
			Width="250"
			Background="#00FFFFFF"
			Focusable="False"
			HorizontalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Border
				Name="BackgroundBorder"
				Grid.ColumnSpan="6"
				CornerRadius="6"
				Background="#A0FFFFFF"
				BorderThickness="1"
				BorderBrush="#80666666" />
			<CheckBox
				Tag="Interactive"
				Name="SelectCheckBox"
				Grid.Column="0"
				IsChecked="True"
				Style="{StaticResource CheckBoxStyle}"
				pptService:ControlHelper.NormalImage="{StaticResource ImageSource.SelectNormal}"
				pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.SelectSelected}"
				Click="Select_OnClick" />
			<Button
				Tag="Interactive"
				Name="PenButton"
				Grid.Column="1"
				Style="{StaticResource NormalButtonStyle}"
				Click="Pen_OnClick">
				<ContentControl.Content>
					<Grid>
						<Image
							Name="PenImage"
							Source="{StaticResource ImageSource.GrayPenNormal}" />
						<Image
							Name="SelectedPenImage"
							Visibility="Collapsed">
							<Image.Source>
								<DrawingImage>
									<DrawingImage.Drawing>
										<DrawingGroup>
											<DrawingGroup.Children>
												<GeometryDrawing>
													<GeometryDrawing.Brush>
														<SolidColorBrush
															Color="#FFD8D8D8"
															Opacity="0" />
													</GeometryDrawing.Brush>
													<GeometryDrawing.Geometry>
														<PathGeometry
															FillRule="Nonzero"
															Figures="M31,31L32,31 32,32 31,32 31,31z M0,0L1,0 1,1 0,1 0,0z" />
													</GeometryDrawing.Geometry>
												</GeometryDrawing>
												<DrawingGroup
													Transform="0.707106781186547,0.707106781186548,-0.707106781186548,0.707106781186547,24.1629511554251,2.51522862093623E-07">
													<DrawingGroup.Children>
														<DrawingGroup>
															<DrawingGroup.Children>
																<GeometryDrawing
																	Brush="{Binding PenBrush}">
																	<GeometryDrawing.Geometry>
																		<PathGeometry
																			FillRule="Nonzero"
																			Figures="M10.4,23L10.4,23 10.4,31.9 5.5,36.9 0.5,31.9 0.5,23z" />
																	</GeometryDrawing.Geometry>
																</GeometryDrawing>
																<DrawingGroup
																	Opacity="0.4">
																	<DrawingGroup.Children>
																		<GeometryDrawing
																			Brush="#FF000000">
																			<GeometryDrawing.Geometry>
																				<PathGeometry
																					FillRule="Nonzero"
																					Figures="M2.5,25L8.4,25 8.4,31.1 5.5,34 2.5,31 2.5,25 M0.5,23L0.6,31.9 5.5,36.8 10.4,31.9 10.4,23 0.5,23 0.5,23z" />
																			</GeometryDrawing.Geometry>
																		</GeometryDrawing>
																	</DrawingGroup.Children>
																</DrawingGroup>
															</DrawingGroup.Children>
														</DrawingGroup>
														<DrawingGroup>
															<DrawingGroup.Children>
																<GeometryDrawing
																	Brush="#FF666666">
																	<GeometryDrawing.Geometry>
																		<PathGeometry
																			FillRule="Nonzero"
																			Figures="M1.4,20L1.3,3.7C1.3,3.2 1.5,2.7 1.9,2.3 2.3,1.9 2.8,1.7 3.3,1.7L7.3,1.7C8.4,1.7,9.3,2.6,9.3,3.7L9.4,20 1.4,20z" />
																	</GeometryDrawing.Geometry>
																</GeometryDrawing>
																<GeometryDrawing
																	Brush="#FF666666">
																	<GeometryDrawing.Geometry>
																		<PathGeometry
																			FillRule="Nonzero"
																			Figures="M2.6,3C2.7,2.9,2.9,2.7,3.3,2.7L7.3,2.7C7.9,2.7,8.3,3.1,8.3,3.7L8.4,19 2.5,19 2.3,3.7C2.3,3.3,2.5,3.1,2.6,3 M1.2,1.6C0.6,2.1,0.3,2.9,0.3,3.7L0.4,21 10.3,21 10.3,3.7C10.3,2,8.9,0.7,7.3,0.7L3.3,0.7C2.4,0.7,1.7,1,1.2,1.6L1.2,1.6z" />
																	</GeometryDrawing.Geometry>
																</GeometryDrawing>
															</DrawingGroup.Children>
														</DrawingGroup>
													</DrawingGroup.Children>
												</DrawingGroup>
											</DrawingGroup.Children>
										</DrawingGroup>
									</DrawingImage.Drawing>
								</DrawingImage>
							</Image.Source>
						</Image>
					</Grid>
				</ContentControl.Content>
			</Button>
			<CheckBox
				Tag="Interactive"
				Name="RubberCheckBox"
				Grid.Column="2"
				IsChecked="False"
				Style="{StaticResource CheckBoxStyle}"
				pptService:ControlHelper.NormalImage="{StaticResource ImageSource.RubberNormal}"
				pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.RubberSelected}"
				Click="Rubber_OnClick" />
			<pptService:ImageButton
				Tag="Interactive"
				Click="Magnifier_Click"
				Grid.Column="3"
				NormalSource="{StaticResource ImageSource.MagnifierNormal}"
				PressedSource="{StaticResource ImageSource.MagnifierSelected}" />
			<CheckBox
				Tag="Interactive"
				Name="InnerBoardCheckBox"
				Grid.Column="4"
				IsChecked="False"
				Style="{StaticResource CheckBoxStyle}"
				pptService:ControlHelper.NormalImage="{StaticResource ImageSource.PlateNormal}"
				pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.PlateSelected}"
				Click="InnerBoard_Click" />
			<Popup
				Tag="Interactive"
				Name="ColorDiskPopup"
				Grid.Column="0"
				Grid.ColumnSpan="4"
				Width="150"
				Height="50"
				StaysOpen="False"
				Placement="Top"
				AllowsTransparency="True"
				Opened="ColorDiskPopup_OnOpened">
				<Grid
					Background="#00FFFFFF">
					<Grid
						Name="ColorDiskStoryBoardGrid"
						RenderTransformOrigin="0.5,1">
						<UIElement.RenderTransform>
							<TransformGroup>
								<ScaleTransform
									ScaleX="0"
									ScaleY="0" />
							</TransformGroup>
						</UIElement.RenderTransform>
						<Image
							Source="{StaticResource ImageSource.ColorDisk}"
							Stretch="Fill" />
						<Grid
							Name="ColorDiskGrid"
							Height="25"
							Margin="0 0 0 7">
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<RadioButton
								Name="RedRadioButton"
								Background="#FFFF0000"
								Grid.Column="0"
								Style="{StaticResource ColorRadioButtonStyle}"
								Click="RadioButton_OnClick" />
							<RadioButton
								Name="BlueRadioButton"
								Background="#0085CD"
								Grid.Column="1"
								Style="{StaticResource ColorRadioButtonStyle}"
								Click="RadioButton_OnClick" />
							<RadioButton
								Name="BlackRadioButton"
								Background="#FF000000"
								Grid.Column="2"
								Style="{StaticResource ColorRadioButtonStyle}"
								Click="RadioButton_OnClick" />
						</Grid>
					</Grid>
				</Grid>
			</Popup>
		</Grid>
		<Grid
			Name="PlaceholderGrid"
			Column="3"
			Width="4" />
		<Grid
			Name="HideGrid"
			Column="4"
			Width="50">
			<pptService:ImageButton
				Tag="Interactive"
				Click="Hide_OnClick"
				Background="#A0FFFFFF"
				BorderThickness="1"
				NormalSource="{StaticResource ImageSource.HideNormal}"
				PressedSource="{StaticResource ImageSource.HideSelected}" />
		</Grid>
		<Grid
			Name="ExitGrid"
			Column="5"
			Width="50">
			<pptService:ImageButton
				Tag="Interactive"
				Click="Exit_OnClick"
				Background="#A0FFFFFF"
				BorderThickness="1"
				NormalSource="{StaticResource ImageSource.ExitNormal}"
				PressedSource="{StaticResource ImageSource.ExitSelected}" />
		</Grid>
	</Grid>
</UserControl>
