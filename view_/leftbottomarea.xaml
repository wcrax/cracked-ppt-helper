<UserControl
	x:Class="PPTService.LeftBottomArea" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pptService="clr-namespace:PPTService" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/ButtonStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Images_/Images.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="RootGrid"
		Width="158"
		Height="50"
		HorizontalAlignment="Left">
		<UIElement.RenderTransform>
			<TranslateTransform
				Y="0" />
		</UIElement.RenderTransform>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition />
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup
				x:Name="AdaptiveStates">
				<VisualState
					x:Name="Adaptive0">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="RootGrid"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="RootGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="94" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="PlaceholderGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="2" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="PlaceholderGrid1"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="2" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState
					x:Name="Adaptive1440" />
				<VisualState
					x:Name="Adaptive3800">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="RootGrid"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="100" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="RootGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="316" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="PlaceholderGrid"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="8" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="PlaceholderGrid1"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="8" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<pptService:AdaptiveTrigger
				MinWindowWidth="0">
				<ei:GoToStateAction
					StateName="Adaptive0" />
			</pptService:AdaptiveTrigger>
			<pptService:AdaptiveTrigger
				MinWindowWidth="1440">
				<ei:GoToStateAction
					StateName="Adaptive1440" />
			</pptService:AdaptiveTrigger>
			<pptService:AdaptiveTrigger
				MinWindowWidth="3800">
				<ei:GoToStateAction
					StateName="Adaptive3800" />
			</pptService:AdaptiveTrigger>
		</i:Interaction.Triggers>
		<pptService:ImageButton
			Click="Previous_Click"
			Grid.Column="0"
			Background="#A0FFFFFF"
			BorderThickness="1"
			NormalSource="{StaticResource ImageSource.HorizontalPreviousSlideNormal}"
			PressedSource="{StaticResource ImageSource.HorizontalPreviousSlideSelected}" />
		<Grid
			Name="PlaceholderGrid"
			Column="1"
			Width="4" />
		<pptService:ImageButton
			Click="Thumbnail_Click"
			Grid.Column="2"
			Background="#A0FFFFFF"
			BorderThickness="1">
			<ContentControl.Content>
				<TextBlock
					Name="LeftSlideIndexTextBlock"
					FontFamily="微软雅黑"
					Foreground="#666666"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Focusable="False"
					FocusVisualStyle="{x:Null}" />
			</ContentControl.Content>
		</pptService:ImageButton>
		<Grid
			Name="PlaceholderGrid1"
			Column="3"
			Width="4" />
		<pptService:ImageButton
			Click="Next_Click"
			Grid.Column="4"
			Background="#A0FFFFFF"
			BorderThickness="1"
			NormalSource="{StaticResource ImageSource.HorizontalNextSlideNormal}"
			PressedSource="{StaticResource ImageSource.HorizontalNextSlideSelected}" />
	</Grid>
</UserControl>
