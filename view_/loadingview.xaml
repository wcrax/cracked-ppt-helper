<UserControl
	x:Class="PPTService.LoadingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:pptService="clr-namespace:PPTService" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Images_/Images.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/WindowStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/ProgressBarStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="RootGrid">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Storyboard
					x:Key="StoryBoard.ShowRootGrid">
					<DoubleAnimationUsingKeyFrames
						Storyboard.TargetName="MaskGrid"
						Storyboard.TargetProperty="Opacity">
						<EasingDoubleKeyFrame
							KeyTime="0:0:1"
							Value="0.6" />
					</DoubleAnimationUsingKeyFrames>
				</Storyboard>
				<Storyboard
					x:Key="StoryBoard.HiddenRootGrid">
					<DoubleAnimationUsingKeyFrames
						Storyboard.TargetName="MaskGrid"
						Storyboard.TargetProperty="Opacity">
						<EasingDoubleKeyFrame
							KeyTime="0:0:0.2"
							Value="0" />
					</DoubleAnimationUsingKeyFrames>
				</Storyboard>
				<Storyboard
					x:Key="StoryBoard.HiddenRootGridImmediately"
					Completed="StoryBoard_HiddenRootGridImmediately_OnCompleted">
					<DoubleAnimationUsingKeyFrames
						Storyboard.TargetName="MaskGrid"
						Storyboard.TargetProperty="Opacity">
						<EasingDoubleKeyFrame
							KeyTime="0:0:0"
							Value="0" />
					</DoubleAnimationUsingKeyFrames>
				</Storyboard>
				<Style
					TargetType="{x:Type Button}"
					x:Key="Style.CancelButton">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Viewbox
									Name="RootViewbox"
									Width="{TemplateBinding Width}"
									Height="{TemplateBinding Height}">
									<Border
										Name="RootBorder"
										CornerRadius="19"
										Height="38"
										Width="100"
										BorderThickness="2"
										BorderBrush="#CCFFFFFF"
										Background="#01000000">
										<TextBlock
											Name="ContentTextBlock"
											Text="取消"
											FontSize="{TemplateBinding FontSize}"
											Foreground="#CCFFFFFF"
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</Viewbox>
								<ControlTemplate.Triggers>
									<Trigger
										Property="IsPressed"
										Value="True">
										<Setter
											TargetName="RootBorder"
											Property="BorderBrush"
											Value="#99FFFFFF" />
										<Setter
											TargetName="ContentTextBlock"
											Property="Foreground"
											Value="#99FFFFFF" />
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											TargetName="RootBorder"
											Property="UIElement.Opacity"
											Value="0.3" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid
			Name="MaskGrid"
			Background="#FF000000"
			Opacity="0.0" />
		<StackPanel
			Orientation="Vertical"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">
			<Grid
				Name="ProgressGrid"
				Width="150"
				Height="150">
				<VisualStateManager.VisualStateGroups>
					<VisualStateGroup
						x:Name="AdaptiveStates">
						<VisualState
							x:Name="Adaptive0">
							<Storyboard>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="ProgressGrid"
									Storyboard.TargetProperty="(FrameworkElement.Width)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="100" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="ProgressGrid"
									Storyboard.TargetProperty="(FrameworkElement.Height)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="100" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="CancelButton"
									Storyboard.TargetProperty="(FrameworkElement.Width)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="60" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="CancelButton"
									Storyboard.TargetProperty="(FrameworkElement.Height)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="23" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="CancelButton"
									Storyboard.TargetProperty="FontSize">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="12" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="LoadProgressTextBlock"
									Storyboard.TargetProperty="FontSize">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="20" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="TipTextBlock"
									Storyboard.TargetProperty="FontSize">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="12" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</VisualState>
						<VisualState
							x:Name="Adaptive1440" />
						<VisualState
							x:Name="Adaptive3800">
							<Storyboard>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="ProgressGrid"
									Storyboard.TargetProperty="(FrameworkElement.Width)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="300" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="ProgressGrid"
									Storyboard.TargetProperty="(FrameworkElement.Height)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="300" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="CancelButton"
									Storyboard.TargetProperty="(FrameworkElement.Width)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="150" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="CancelButton"
									Storyboard.TargetProperty="(FrameworkElement.Height)">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="57" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="CancelButton"
									Storyboard.TargetProperty="FontSize">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="16" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="LoadProgressTextBlock"
									Storyboard.TargetProperty="FontSize">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="70" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetName="TipTextBlock"
									Storyboard.TargetProperty="FontSize">
									<EasingDoubleKeyFrame
										KeyTime="0"
										Value="24" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</VisualState>
					</VisualStateGroup>
				</VisualStateManager.VisualStateGroups>
				<i:Interaction.Triggers>
					<pptService:AdaptiveTrigger
						MinWindowWidth="0">
						<ei:GoToStateAction
							StateName="Adaptive0" />
					</pptService:AdaptiveTrigger>
					<pptService:AdaptiveTrigger
						MinWindowWidth="1440">
						<ei:GoToStateAction
							StateName="Adaptive1440" />
					</pptService:AdaptiveTrigger>
					<pptService:AdaptiveTrigger
						MinWindowWidth="3800">
						<ei:GoToStateAction
							StateName="Adaptive3800" />
					</pptService:AdaptiveTrigger>
				</i:Interaction.Triggers>
				<ProgressBar
					Name="LoadProgressBar"
					Style="{StaticResource CircularProgressBarStyle}" />
				<StackPanel
					Orientation="Vertical"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<TextBlock
						Name="LoadProgressTextBlock"
						FontSize="35"
						Foreground="#FFFFFFFF"
						HorizontalAlignment="Center" />
					<TextBlock
						Name="TipTextBlock"
						FontSize="16"
						Foreground="#FFFFFFFF"
						Text="加载中..."
						HorizontalAlignment="Center" />
				</StackPanel>
			</Grid>
			<Button
				Name="CancelButton"
				Style="{StaticResource Style.CancelButton}"
				Width="100"
				Height="38"
				FontSize="16"
				Margin="0 15 0 0"
				Click="CancelButton_OnClick" />
		</StackPanel>
		<StackPanel
			Orientation="Vertical"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Margin="0 0 0 120">
			<Image
				Source="{StaticResource Image.Seewo}"
				Stretch="None"
				SnapsToDevicePixels="True"
				UseLayoutRounding="True" />
			<TextBlock
				Text="视睿科技版权所有，未经许可禁止商用"
				Margin="0 20 0 0"
				FontSize="20"
				Foreground="#80FFFFFF" />
		</StackPanel>
	</Grid>
</UserControl>
