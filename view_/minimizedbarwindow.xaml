<Window
	x:Class="PPTService.MinimizedBarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="140"
	Height="30"
	WindowStartupLocation="Manual"
	AllowsTransparency="True"
	WindowStyle="None"
	Background="#00FFFFFF"
	ShowInTaskbar="False"
	Topmost="True"
	Focusable="False"
	ShowActivated="False"
	ResizeMode="NoResize"
	Opacity="0.55"
	PreviewMouseMove="Window_PreviewMouseMove"
	PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
	<Border
		Name="BarBorder"
		Margin="2"
		CornerRadius="13"
		Background="#78000000"
		Cursor="Hand"
		PreviewMouseLeftButtonDown="BarBorder_OnMouseLeftButtonDown"
		MouseEnter="Bar_OnMouseEnter"
		MouseLeave="Bar_OnMouseLeave">
		<Button
			Name="RestoreButton"
			Content="显示PPT工具"
			Click="RestoreButton_Click"
			Focusable="False"
			Background="#00FFFFFF"
			BorderThickness="0"
			Foreground="#E6FFFFFF"
			FontSize="12"
			Cursor="Hand" />
	</Border>
</Window>
