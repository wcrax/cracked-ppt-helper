<Window
	x:Class="PPTService.Magnifier" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pptService="clr-namespace:PPTService" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
	Left="0"
	Top="0"
	Background="#FF000000"
	Topmost="True"
	WindowStyle="None"
	ShowInTaskbar="False"
	ResizeMode="NoResize"
	SnapsToDevicePixels="True">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/ButtonStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/EllipseStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/CheckBoxStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Storyboard
				x:Key="ShowBackgroundImageStoryboard">
				<DoubleAnimation
					Storyboard.TargetName="RootCanvasBackgroundImage"
					Storyboard.TargetProperty="Opacity"
					From="0.03"
					To="1"
					Duration="0:0:0.1" />
			</Storyboard>
			<Storyboard
				x:Key="HiddenBackgroundImageStoryboard">
				<DoubleAnimation
					Storyboard.TargetName="RootCanvasBackgroundImage"
					Storyboard.TargetProperty="Opacity"
					From="1"
					To="0.03"
					Duration="0:0:0.1" />
			</Storyboard>
			<Storyboard
				x:Key="ShowButtonStoryboard">
				<DoubleAnimation
					Storyboard.TargetName="ButtonBorder"
					Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
					From="0"
					To="1"
					Duration="0:0:0.2" />
				<DoubleAnimation
					Storyboard.TargetName="ButtonBorder"
					Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
					From="0"
					To="1"
					Duration="0:0:0.2" />
			</Storyboard>
			<GradientStopCollection
				x:Key="LinearGradientStops">
				<GradientStop
					Color="#66000000"
					Offset="0" />
				<GradientStop
					Color="#00000000"
					Offset="1" />
			</GradientStopCollection>
			<LinearGradientBrush
				StartPoint="0.5,0"
				EndPoint="0.5,1"
				GradientStops="{StaticResource LinearGradientStops}"
				x:Key="TopLinearGradientBrush" />
			<LinearGradientBrush
				StartPoint="0,0.5"
				EndPoint="1,0.5"
				GradientStops="{StaticResource LinearGradientStops}"
				x:Key="LeftLinearGradientBrush" />
			<LinearGradientBrush
				StartPoint="1,0.5"
				EndPoint="0,0.5"
				GradientStops="{StaticResource LinearGradientStops}"
				x:Key="RightLinearGradientBrush" />
			<LinearGradientBrush
				StartPoint="0.5,1"
				EndPoint="0.5,0"
				GradientStops="{StaticResource LinearGradientStops}"
				x:Key="BottomLinearGradientBrush" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Canvas
		Name="RootCanvas"
		MouseLeftButtonDown="MagnifierRectangle_OnMouseLeftButtonDown"
		MouseMove="MagnifierRectangle_OnMouseMove"
		MouseLeftButtonUp="MagnifierRectangle_OnMouseLeftButtonUp">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup
				x:Name="AdaptiveStates">
				<VisualState
					x:Name="Adaptive0">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="InnerLeftTopThumbBorder"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="10" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="InnerLeftTopThumbBorder"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="10" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ButtonBorder"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="25" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ButtonBorder"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="50" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="ButtonBorder"
							Storyboard.TargetProperty="CornerRadius">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<CornerRadius>2</CornerRadius>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="ClosePath"
							Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<Thickness>3</Thickness>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState
					x:Name="Adaptive1440" />
				<VisualState
					x:Name="Adaptive3800">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="InnerLeftTopThumbBorder"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="32" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="InnerLeftTopThumbBorder"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="32" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ButtonBorder"
							Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="80" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames
							Storyboard.TargetName="ButtonBorder"
							Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame
								KeyTime="0"
								Value="160" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="ButtonBorder"
							Storyboard.TargetProperty="CornerRadius">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<CornerRadius>6</CornerRadius>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames
							Storyboard.TargetName="ClosePath"
							Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame
								KeyTime="0">
								<ObjectKeyFrame.Value>
									<Thickness>10</Thickness>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<pptService:AdaptiveTrigger
				MinWindowHeight="0">
				<ei:GoToStateAction
					StateName="Adaptive0" />
			</pptService:AdaptiveTrigger>
			<pptService:AdaptiveTrigger
				MinWindowHeight="770">
				<ei:GoToStateAction
					StateName="Adaptive1440" />
			</pptService:AdaptiveTrigger>
			<pptService:AdaptiveTrigger
				MinWindowHeight="2100">
				<ei:GoToStateAction
					StateName="Adaptive3800" />
			</pptService:AdaptiveTrigger>
		</i:Interaction.Triggers>
		<Panel.Background>
			<ImageBrush
				x:Name="RootCanvasBackgroundImage"
				Stretch="Fill" />
		</Panel.Background>
		<Grid
			Name="RootGrid"
			Canvas.Left="0"
			Canvas.Top="0"
			Canvas.Right="0"
			Canvas.Bottom="0"
			SnapsToDevicePixels="True">
			<Border
				Name="InnerMagnifierBorder"
				BorderThickness="4"
				BorderBrush="#C6C6C6">
				<Rectangle
					Name="MagnifierRectangle"
					IsManipulationEnabled="True"
					MouseLeftButtonDown="MagnifierRectangle_OnMouseLeftButtonDown"
					MouseMove="MagnifierRectangle_OnMouseMove"
					MouseLeftButtonUp="MagnifierRectangle_OnMouseLeftButtonUp"
					ManipulationStarting="MagnifierRectangle_OnManipulationStarting"
					ManipulationDelta="MagnifierRectangle_OnManipulationDelta"
					ManipulationCompleted="MagnifierRectangle_OnManipulationCompleted"
					MouseWheel="MagnifierRectangle_OnMouseWheel">
					<Shape.Fill>
						<ImageBrush
							x:Name="MagnifierImage"
							ViewboxUnits="Absolute"
							ViewportUnits="RelativeToBoundingBox"
							Viewport="0,0,1,1" />
					</Shape.Fill>
				</Rectangle>
			</Border>
			<Grid
				Name="InnerMagnifierShadowGrid"
				Column="0"
				Margin="4"
				SnapsToDevicePixels="True">
				<Rectangle
					Fill="{StaticResource TopLinearGradientBrush}"
					VerticalAlignment="Top"
					Height="6" />
				<Rectangle
					Fill="{StaticResource LeftLinearGradientBrush}"
					HorizontalAlignment="Left"
					Width="6" />
				<Rectangle
					Fill="{StaticResource RightLinearGradientBrush}"
					HorizontalAlignment="Right"
					Width="6" />
				<Rectangle
					Fill="{StaticResource BottomLinearGradientBrush}"
					VerticalAlignment="Bottom"
					Height="6" />
			</Grid>
			<Grid
				Name="MagnifierBorder"
				Column="0"
				Margin="-30"
				MinWidth="210"
				MinHeight="210">
				<Border
					Name="LeftTopThumbBorder"
					Width="64"
					Height="64"
					Background="#00FFFFFF"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					Cursor="SizeNWSE"
					MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown"
					MouseMove="MagnifierBorder_OnMouseMove"
					MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
					<Ellipse
						Name="InnerLeftTopThumbBorder"
						Width="16"
						Height="16"
						Style="{StaticResource ThumbEllipseStyle}" />
				</Border>
				<Border
					Name="RightTopThumbBorder"
					Width="64"
					Height="64"
					Background="#00FFFFFF"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Cursor="SizeNESW"
					MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown"
					MouseMove="MagnifierBorder_OnMouseMove"
					MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
					<Ellipse
						Name="InnerRightTopThumbBorder"
						Style="{StaticResource ThumbEllipseStyle}"
						Width="{Binding Width, ElementName=InnerLeftTopThumbBorder}"
						Height="{Binding Height, ElementName=InnerLeftTopThumbBorder}" />
				</Border>
				<Border
					Name="LeftBottomThumbBorder"
					Width="64"
					Height="64"
					Background="#00FFFFFF"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Cursor="SizeNESW"
					MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown"
					MouseMove="MagnifierBorder_OnMouseMove"
					MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
					<Ellipse
						Name="InnerLeftBottomThumbBorder"
						Style="{StaticResource ThumbEllipseStyle}"
						Width="{Binding Width, ElementName=InnerLeftTopThumbBorder}"
						Height="{Binding Height, ElementName=InnerLeftTopThumbBorder}" />
				</Border>
				<Border
					Name="RightBottomThumbBorder"
					Width="64"
					Height="64"
					Background="#00FFFFFF"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Cursor="SizeNWSE"
					MouseLeftButtonDown="MagnifierBorder_OnMouseLeftButtonDown"
					MouseMove="MagnifierBorder_OnMouseMove"
					MouseLeftButtonUp="MagnifierBorder_OnMouseLeftButtonUp">
					<Ellipse
						Name="InnerRightBottomThumbBorder"
						Style="{StaticResource ThumbEllipseStyle}"
						Width="{Binding Width, ElementName=InnerLeftTopThumbBorder}"
						Height="{Binding Height, ElementName=InnerLeftTopThumbBorder}" />
				</Border>
			</Grid>
			<Border
				Name="ButtonBorder"
				Width="40"
				Height="80"
				Background="#FFFFFF"
				CornerRadius="4"
				BorderThickness="1"
				SnapsToDevicePixels="True"
				BorderBrush="#CCCCCC"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				RenderTransformOrigin="0.5,0.5">
				<UIElement.RenderTransform>
					<TransformGroup>
						<ScaleTransform />
					</TransformGroup>
				</UIElement.RenderTransform>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<CheckBox
						Name="ChangeBackgroundImageCheckBox"
						Grid.Row="0"
						IsChecked="False"
						Style="{StaticResource Style.MagnifierCheckBox}"
						pptService:ControlHelper.NormalImage="{StaticResource ImageSource.BulbOn}"
						pptService:ControlHelper.CheckedImage="{StaticResource ImageSource.BulbOff}"
						Click="ChangeBackgroundImageCheckBox_OnClick" />
					<Button
						Name="CloseButton"
						Grid.Row="1"
						Style="{StaticResource NormalButtonStyleWidthOutMargin}">
						<ContentControl.Content>
							<Path
								Name="ClosePath"
								Data="M0,0 M24,24 M13.5,12 L18.7,6.8 C19.1,6.4 19.1,5.7 18.7,5.3 C18.3,4.9 17.6,4.9 17.2,5.3 L12,10.5 L6.8,5.3 C6.4,4.9 5.7,4.9 5.3,5.3 C4.9,5.7 4.9,6.4 5.3,6.8 L10.5,12 L5.3,17.2 C4.9,17.6 4.9,18.3 5.3,18.7 C5.7,19.1 6.4,19.1 6.8,18.7 L12,13.5 L17.2,18.7 C17.6,19.1 18.3,19.1 18.7,18.7 C19.1,18.3 19.1,17.6 18.7,17.2 L13.5,12"
								Fill="#666666"
								Stretch="Fill"
								Margin="5" />
						</ContentControl.Content>
					</Button>
				</Grid>
			</Border>
		</Grid>
	</Canvas>
</Window>
