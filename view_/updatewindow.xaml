<Window
	x:Class="PPTService.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pptService="clr-namespace:PPTService"
	Height="170"
	Width="320"
	Style="{DynamicResource Style.Window}"
	WindowStartupLocation="CenterScreen">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Images_/Images.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/WindowStyle.xaml" />
				<ResourceDictionary
					Source="pack://application:,,,/PPTService;component/Style_/ButtonStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Border
			Name="BackgroundBorder"
			Grid.Row="0"
			Grid.RowSpan="3"
			Background="#FFFFFFFF"
			CornerRadius="4"
			Margin="3">
			<UIElement.Effect>
				<DropShadowEffect
					Color="Black"
					Direction="0"
					ShadowDepth="0"
					Opacity="0.6" />
			</UIElement.Effect>
		</Border>
		<Grid
			Row="0"
			Height="40">
			<TextBlock
				Text="更新提示"
				VerticalAlignment="Center"
				Margin="12 0 0 0"
				FontSize="15"
				Foreground="#666666" />
			<Button
				HorizontalAlignment="Right"
				Width="40"
				Style="{StaticResource NormalButtonStyleWidthMargin}"
				pptService:ControlHelper.ContentMargin="5"
				Click="CloseButton_OnClick">
				<Image
					Source="{StaticResource ImageSource.CloseNormal}" />
			</Button>
			<Rectangle
				VerticalAlignment="Bottom"
				Fill="#CCCCCC"
				Height="1"
				Margin="10 0 10 0" />
		</Grid>
		<Grid
			Row="1"
			Margin="0 2 0 0">
			<StackPanel
				Orientation="Vertical">
				<TextBlock
					Margin="15 25 15 0"
					VerticalAlignment="Center"
					FontSize="15"
					Foreground="#666666"
					TextTrimming="CharacterEllipsis"
					TextWrapping="Wrap"
					HorizontalAlignment="Center">
					<Run
						Text="检测到新版PPTService" /> <Run
						Name="VersionRun"
						Text="2.0.0" /></TextBlock>
				<TextBlock
					Margin="15 0 15 0"
					VerticalAlignment="Center"
					FontSize="15"
					Foreground="#666666"
					TextTrimming="CharacterEllipsis"
					TextWrapping="Wrap"
					Text="是否立即更新？"
					HorizontalAlignment="Center" />
			</StackPanel>
			<Rectangle
				VerticalAlignment="Bottom"
				Fill="#CCCCCC"
				Height="1"
				Margin="3 0 3 0" />
		</Grid>
		<Grid
			Row="2"
			Height="40">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Button
				Name="CancelButton"
				Grid.Column="0"
				Style="{StaticResource NormalButtonStyleWidthMargin}"
				pptService:ControlHelper.CornerRadius="0 0 0 4"
				Click="CancelButton_OnClick">
				<TextBlock
					Text="取消"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="16"
					Foreground="#666666" />
			</Button>
			<Rectangle
				Grid.Column="1"
				Fill="#CCCCCC"
				Width="1"
				SnapsToDevicePixels="True" />
			<Button
				Name="UpdateButton"
				Grid.Column="2"
				Style="{StaticResource NormalButtonStyleWidthMargin}"
				pptService:ControlHelper.CornerRadius="0 0 4 0"
				Click="UpdateButton_OnClick">
				<TextBlock
					Text="立即更新"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="16"
					Foreground="#666666" />
			</Button>
		</Grid>
	</Grid>
</Window>
