<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:pptService="clr-namespace:PPTService" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
	<Style
		TargetType="{x:Type RadioButton}"
		x:Key="ColorRadioButtonStyle">
		<Setter
			Property="RadioButton.GroupName"
			Value="ColorButton" />
		<Setter
			Property="Foreground"
			Value="#6FB543" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type RadioButton}">
					<Grid
						Name="RootGrid"
						Background="#00FFFFFF"
						SnapsToDevicePixels="True"
						Width="25"
						Height="25">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="AdaptiveStates">
								<VisualState
									x:Name="Adaptive0">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="RootGrid"
											Storyboard.TargetProperty="(FrameworkElement.Width)">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="15" />
										</DoubleAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="RootGrid"
											Storyboard.TargetProperty="(FrameworkElement.Height)">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="15" />
										</DoubleAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames
											Storyboard.TargetName="normal"
											Storyboard.TargetProperty="Margin">
											<DiscreteObjectKeyFrame
												KeyTime="0">
												<ObjectKeyFrame.Value>
													<Thickness>2</Thickness>
												</ObjectKeyFrame.Value>
											</DiscreteObjectKeyFrame>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Adaptive1440" />
								<VisualState
									x:Name="Adaptive3800">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="RootGrid"
											Storyboard.TargetProperty="(FrameworkElement.Width)">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="50" />
										</DoubleAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="RootGrid"
											Storyboard.TargetProperty="(FrameworkElement.Height)">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="50" />
										</DoubleAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames
											Storyboard.TargetName="normal"
											Storyboard.TargetProperty="Margin">
											<DiscreteObjectKeyFrame
												KeyTime="0">
												<ObjectKeyFrame.Value>
													<Thickness>5</Thickness>
												</ObjectKeyFrame.Value>
											</DiscreteObjectKeyFrame>
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<i:Interaction.Triggers>
							<pptService:AdaptiveTrigger
								MinWindowWidth="0">
								<ei:GoToStateAction
									StateName="Adaptive0" />
							</pptService:AdaptiveTrigger>
							<pptService:AdaptiveTrigger
								MinWindowWidth="1440">
								<ei:GoToStateAction
									StateName="Adaptive1440" />
							</pptService:AdaptiveTrigger>
							<pptService:AdaptiveTrigger
								MinWindowWidth="3800">
								<ei:GoToStateAction
									StateName="Adaptive3800" />
							</pptService:AdaptiveTrigger>
						</i:Interaction.Triggers>
						<Ellipse
							Name="checked"
							Stroke="{TemplateBinding Foreground}"
							StrokeThickness="1"
							Visibility="Collapsed" />
						<Ellipse
							Name="normal"
							Fill="{TemplateBinding Background}"
							StrokeThickness="0"
							Margin="3" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="true">
							<Setter
								TargetName="checked"
								Property="Visibility"
								Value="Visible" />
						</Trigger>
						<Trigger
							Property="ToggleButton.IsChecked"
							Value="false">
							<Setter
								TargetName="checked"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
