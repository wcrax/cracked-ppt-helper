<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pptService="clr-namespace:PPTService" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions">
	<Style
		TargetType="{x:Type ProgressBar}"
		x:Key="CircularProgressBarStyle">
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ProgressBar}">
					<Grid
						Name="LayoutRoot">
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup
								x:Name="AdaptiveStates">
								<VisualState
									x:Name="Adaptive0">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="ProgressEllipse"
											Storyboard.TargetProperty="StrokeThickness">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="5" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState
									x:Name="Adaptive1440" />
								<VisualState
									x:Name="Adaptive3800">
									<Storyboard>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="ProgressEllipse"
											Storyboard.TargetProperty="StrokeThickness">
											<EasingDoubleKeyFrame
												KeyTime="0"
												Value="12" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<i:Interaction.Triggers>
							<pptService:AdaptiveTrigger
								MinWindowWidth="0">
								<ei:GoToStateAction
									StateName="Adaptive0" />
							</pptService:AdaptiveTrigger>
							<pptService:AdaptiveTrigger
								MinWindowWidth="1440">
								<ei:GoToStateAction
									StateName="Adaptive1440" />
							</pptService:AdaptiveTrigger>
							<pptService:AdaptiveTrigger
								MinWindowWidth="3800">
								<ei:GoToStateAction
									StateName="Adaptive3800" />
							</pptService:AdaptiveTrigger>
						</i:Interaction.Triggers>
						<pptService:AttachedViewModelBase.Attach>
							<pptService:CircularProgressBarViewModel
								HoleSizeFactor="0.914" />
						</pptService:AttachedViewModelBase.Attach>
						<Ellipse
							Name="ProgressEllipse"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Stroke="#99000000"
							Opacity="0.5"
							Fill="#00FFFFFF"
							StrokeThickness="6"
							Width="{Binding Diameter}"
							Height="{Binding Diameter}" />
						<pptService:PiePiece
							RotationAngle="0"
							Fill="#FFFFFFFF"
							CentreX="{Binding CentreX}"
							CentreY="{Binding CentreY}"
							WedgeAngle="{Binding Angle}"
							Radius="{Binding Radius}"
							InnerRadius="{Binding InnerRadius}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
