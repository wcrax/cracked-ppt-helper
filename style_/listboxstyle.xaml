		<Setter
			Property="FrameworkElement.FocusVisualStyle"
			Value="{x:Null}" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="FrameworkElement.Tag"
			Value="{Binding IsPptThumbnail}" />
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate
					TargetType="{x:Type ListBoxItem}">
					<Grid
						Name="RootGrid"
						Margin="0 0 0 10"
						Width="90"
						Height="65">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Grid
							Name="PerchGrid"
							Row="0"
							Height="8"
							Background="#00FFFFFF" />
						<Grid
							Name="SlideIndexBackgroundGrid"
							Row="0"
							RowSpan="2"
							Height="13"
							Width="20"
							Margin="3 0 0 0"
							HorizontalAlignment="Left"
							VerticalAlignment="Top">
							<Path
								Name="SlideIndexBackgroundPath"
								Data="M0,0 L30,0 L40,30 L0,30 L0,0"
								Stroke="#A0666666"
								Fill="#FFFFFFFF"
								Stretch="Fill" />
						</Grid>
						<Grid
							Name="SlideIndexGrid"
							Row="0"
							RowSpan="2"
							Margin="3 2 0 0"
							Width="15"
							HorizontalAlignment="Left"
							VerticalAlignment="Top">
							<TextBlock
								Name="SlideTextBlock"
								FontSize="6"
								HorizontalAlignment="Center"
								Text="{Binding Index}" />
						</Grid>
						<Border
							Name="SlideBorder"
							Grid.Row="1"
							BorderThickness="1"
							Margin="3"
							BorderBrush="#80666666">
							<Grid
								Background="#FFFFFFFF">
								<Image
									Name="SlideImage"
									Stretch="Fill"
									Source="{Binding BitmapImage}" />
								<Border
									Name="InnerSlideBorder"
									BorderThickness="1"
									BorderBrush="#FFFFFFFF"
									SnapsToDevicePixels="True" />
							</Grid>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="FrameworkElement.Tag"
							Value="False">
							<Setter
								TargetName="SlideImage"
								Property="Source"
								Value="{StaticResource ImageSource.Placeholder}" />
						</Trigger>
						<Trigger
							Property="ListBoxItem.IsSelected"
							Value="True">
							<Setter
								TargetName="SlideBorder"
								Property="BorderBrush"
								Value="#FFFF7F50" />
							<Setter
								TargetName="SlideBorder"
								Property="BorderThickness"
								Value="2" />
							<Setter
								TargetName="SlideBorder"
								Property="Margin"
								Value="2" />
							<Setter
								TargetName="SlideIndexBackgroundGrid"
								Property="Margin"
								Value="2 0 0 0" />
							<Setter
								TargetName="SlideIndexBackgroundPath"
								Property="Stroke"
								Value="#FFFF7F50" />
							<Setter
								TargetName="SlideIndexBackgroundPath"
								Property="Fill"
								Value="#FFFF7F50" />
							<Setter
								TargetName="SlideIndexBackgroundPath"
								Property="StrokeThickness"
								Value="2" />
							<Setter
								TargetName="SlideTextBlock"
								Property="Foreground"
								Value="#FFFFFFFF" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
